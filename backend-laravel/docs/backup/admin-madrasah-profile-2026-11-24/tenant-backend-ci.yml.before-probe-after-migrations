name: Tenant Backend CI

on:
  push:
    branches:
      - source-import/p0-87
      - work/schema-dump-export-20261119
      - fix/web-portal-usability-rbac-20261120
      - work/web-admin-implementation-20261123
      - work/solo-web-cbt-completion-20261123
      - work/solo-web-cbt-ci-repair-20261123
      - work/solo-web-cbt-next-20261123
      - work/solo-web-cbt-completion-20261123-execution
      - work/solo-web-cbt-phpunit-20261124
      - work/solo-web-cbt-phpunit-final-20261124
      - work/solo-web-cbt-role-rbac-20261123
  pull_request:
    branches:
      - main
      - work/web-admin-implementation-20261123
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: tenant-backend-ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  laravel-mysql:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    services:
      mysql:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: root
          MYSQL_DATABASE: cbt_ci_p089
        ports:
          - 3306:3306
        options: >-
          --health-cmd="mysqladmin ping -h 127.0.0.1 -uroot -proot"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=10

    defaults:
      run:
        working-directory: backend-laravel

    env:
      APP_ENV: testing
      APP_DEBUG: "true"
      CBT_LICENSE_TEST_BYPASS: "true"
      APP_KEY: base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
      DB_CONNECTION: mysql
      DB_HOST: 127.0.0.1
      DB_PORT: "3306"
      DB_DATABASE: cbt_ci_p089
      DB_USERNAME: root
      DB_PASSWORD: root
      CACHE_STORE: array
      SESSION_DRIVER: array
      QUEUE_CONNECTION: sync
      MAIL_MAILER: array
      CBT_INSTALLER_E2E: "1"
      CBT_INSTALLER_E2E_DB_HOST: "127.0.0.1"
      CBT_INSTALLER_E2E_DB_PORT: "3306"
      CBT_INSTALLER_E2E_DB_DATABASE: "cbt_installer_test_pilot"
      CBT_INSTALLER_E2E_DB_USERNAME: root
      CBT_INSTALLER_E2E_DB_PASSWORD: root

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup PHP 8.3
        uses: shivammathur/setup-php@v2
        with:
          php-version: "8.3"
          extensions: mbstring, bcmath, ctype, fileinfo, pdo_mysql, tokenizer, xml, curl, dom, gd, zip
          coverage: none
          tools: composer:v2

      - name: Verify isolated MySQL identity (fail closed)
        shell: bash
        run: |
          set -euo pipefail
          test "$APP_ENV" = "testing"
          test "$DB_CONNECTION" = "mysql"
          test "$DB_HOST" = "127.0.0.1"
          test "$DB_DATABASE" = "cbt_ci_p089"
          test "$DB_USERNAME" = "root"
          test "$DB_PASSWORD" = "root"
          php -r '
            $pdo = new PDO(
              "mysql:host=" . getenv("DB_HOST") . ";port=" . getenv("DB_PORT") . ";dbname=" . getenv("DB_DATABASE"),
              getenv("DB_USERNAME"),
              getenv("DB_PASSWORD"),
              [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
            );
            $db = $pdo->query("SELECT DATABASE() AS db, VERSION() AS version")->fetch(PDO::FETCH_ASSOC);
            $engine = $pdo->query(
              "SELECT ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'tenants'"
            )->fetchColumn();
            if ($db["db"] !== "cbt_ci_p089" || !str_starts_with($db["version"], "8.") || strtoupper((string) $engine) !== "INNODB") {
              fwrite(STDERR, "Disposable MySQL identity/tenant table engine check failed.\\n");
              exit(1);
            }
            echo "Disposable DB verified: " . $db["db"] . " / MySQL " . $db["version"] . " / tenants ENGINE=" . $engine . PHP_EOL;          '

      - name: Validate Composer lock and platform
        run: composer validate --no-check-publish

      - name: Install locked dependencies without Composer scripts
        run: composer install --no-interaction --prefer-dist --no-progress --no-scripts

      - name: Prepare writable Laravel runtime directories
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p bootstrap/cache storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs
          chmod -R u+rwX bootstrap/cache storage/framework storage/logs

      - name: Discover Laravel packages explicitly
        run: php artisan package:discover --ansi

      - name: Prepare empty test environment file
        run: touch .env

      - name: Create isolated disposable installer E2E database
        shell: bash
        run: |
          set -euo pipefail
          test "$CBT_INSTALLER_E2E" = "1"
          test "$CBT_INSTALLER_E2E_DB_DATABASE" = "cbt_installer_test_pilot"
          test "$CBT_INSTALLER_E2E_DB_DATABASE" != "$DB_DATABASE"
          mysql --host="$DB_HOST" --port="$DB_PORT" --user="$DB_USERNAME" --password="$DB_PASSWORD" \
            --execute="CREATE DATABASE IF NOT EXISTS cbt_installer_test_pilot CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"

      - name: Run focused Web login and tenant identity smoke tests
        run: php artisan test --display-warnings --filter='WebAdminAuthTest|StudentWebLoginTest'

      - name: Run focused Admin Livewire reauthorization regression tests
        run: php artisan test --display-warnings --filter='AdminLivewireReauthorizationTest'

      - name: Run focused Teacher result Livewire reauthorization regression tests
        run: php artisan test --display-warnings --filter='TeacherResultLivewireReauthorizationTest'

      - name: Run complete PHPUnit suite against disposable MySQL 8
        run: php artisan test --display-warnings
