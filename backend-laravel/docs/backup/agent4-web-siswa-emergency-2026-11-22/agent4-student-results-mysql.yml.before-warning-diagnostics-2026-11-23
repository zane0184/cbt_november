name: Agent 4 — Student Results MySQL Feature Tests

on:
  push:
    branches:
      - work/agent4-web-siswa-emergency-20261122
  pull_request:
    branches:
      - work/stage4d-account-lifecycle-20261122
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: agent4-student-results-mysql-${{ github.ref }}
  cancel-in-progress: false

jobs:
  student-results-feature:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    services:
      mysql:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: root
          MYSQL_DATABASE: cbt_agent4_test
        ports:
          - 3306:3306
        options: >-
          --health-cmd="mysqladmin ping -h 127.0.0.1 -proot"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=12
    defaults:
      run:
        working-directory: backend-laravel
    env:
      APP_ENV: testing
      APP_KEY: base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
      CBT_LICENSE_TEST_BYPASS: "true"
      DB_CONNECTION: mysql
      DB_HOST: 127.0.0.1
      DB_PORT: "3306"
      DB_DATABASE: cbt_agent4_test
      DB_USERNAME: root
      DB_PASSWORD: root
      CACHE_STORE: array
      SESSION_DRIVER: array
      QUEUE_CONNECTION: sync
      MAIL_MAILER: array
    steps:
      - name: Checkout exact Web Siswa branch
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - name: Set up PHP 8.3
        uses: shivammathur/setup-php@v2
        with:
          php-version: "8.3"
          extensions: bcmath, ctype, curl, dom, fileinfo, gd, intl, mbstring, pdo_mysql, tokenizer, xml, zip
          coverage: none

      - name: Prepare Laravel writable runtime directories
        run: mkdir -p bootstrap/cache storage/framework/cache storage/framework/sessions storage/framework/views storage/logs && chmod -R ug+rwX bootstrap/cache storage

      - name: Validate Composer manifest
        run: composer validate --no-check-publish

      - name: Install PHP dependencies
        run: composer install --prefer-dist --no-interaction --no-progress

      - name: Verify disposable MySQL 8 service
        run: php -r '$pdo = new PDO("mysql:host=127.0.0.1;port=3306;dbname=cbt_agent4_test", "root", "root"); echo $pdo->query("SELECT VERSION()")->fetchColumn(), PHP_EOL;'

      - name: Run Student result visibility feature tests
        run: php artisan test tests/Feature/StudentResultVisibilityTest.php
