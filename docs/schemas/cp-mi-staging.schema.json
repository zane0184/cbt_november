{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbt.min15jakarta.sch.id/schemas/cp-mi-staging.schema.json",
  "title": "CP MI Staging Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_key",
    "document_number",
    "source_sha256",
    "source_pdf_page",
    "subject_code",
    "subject_name",
    "phase",
    "grade_start",
    "grade_end",
    "element",
    "description_source",
    "source_status",
    "transcription_status"
  ],
  "properties": {
    "record_key": {"type": "string", "minLength": 1},
    "document_number": {"const": "SK Dirjen Pendis 9941 Tahun 2025"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_pdf_page": {"type": "integer", "minimum": 1, "maximum": 107},
    "source_printed_page": {"type": ["integer", "null"], "minimum": 1},
    "subject_code": {"type": "string", "minLength": 1},
    "subject_name": {
      "enum": ["Al-Qur'an Hadis", "Akidah Akhlak", "Fikih", "Sejarah Kebudayaan Islam", "Bahasa Arab"]
    },
    "phase": {"enum": ["A", "B", "C"]},
    "grade_start": {"type": "integer", "enum": [1, 3, 5]},
    "grade_end": {"type": "integer", "enum": [2, 4, 6]},
    "element": {
      "enum": ["Pemahaman Konsep", "Keterampilan Proses", "Komponen Bahasa", "Keterampilan Bahasa"]
    },
    "sub_element": {"type": ["string", "null"]},
    "source_code": {"type": ["string", "null"]},
    "internal_code": {"type": ["string", "null"]},
    "description_source": {"type": "string", "minLength": 1},
    "source_status": {
      "const": "USER_SUPPLIED_COPY_CONTENT_REVIEWED_SIGNATURE_NOT_CRYPTOGRAPHICALLY_VERIFIED"
    },
    "transcription_status": {
      "enum": ["PENDING_VISUAL_QA", "VISUAL_QA_PASSED"]
    },
    "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "A"}}, "required": ["phase"]},
      "then": {"properties": {"grade_start": {"const": 1}, "grade_end": {"const": 2}}}
    },
    {
      "if": {"properties": {"phase": {"const": "B"}}, "required": ["phase"]},
      "then": {"properties": {"grade_start": {"const": 3}, "grade_end": {"const": 4}}}
    },
    {
      "if": {"properties": {"phase": {"const": "C"}}, "required": ["phase"]},
      "then": {"properties": {"grade_start": {"const": 5}, "grade_end": {"const": 6}}}
    },
    {
      "if": {"properties": {"subject_name": {"const": "Sejarah Kebudayaan Islam"}}, "required": ["subject_name"]},
      "then": {"properties": {"phase": {"enum": ["B", "C"]}}}
    },
    {
      "if": {"properties": {"subject_name": {"const": "Bahasa Arab"}}, "required": ["subject_name"]},
      "then": {"properties": {"element": {"enum": ["Komponen Bahasa", "Keterampilan Bahasa"]}}}
    }
  ]
}
